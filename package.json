{
  "name": "local-net-check",
  "version": "0.2.0",
  "private": true,
  "description": "Local network monitor: a wired backbone reference node plus a portable Wi-Fi survey probe, aggregated centrally into a room x hour heatmap.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "server": "node src/server/index.ts",
    "probe": "node src/probe/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test \"test/*.test.ts\"",
    "test:unit": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
